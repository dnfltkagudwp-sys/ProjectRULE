  rules:
  - AnomalyA: {fileID: 11400000, guid: 8dc51f2ba556c854ca3f6e8bef258b90, type: 2}
    AnomalyB: {fileID: 11400000, guid: ca5995432df2a8c4c83042005ed0b685, type: 2}
    State: 2
    Note: "\uAC19\uC740 \uC810\uAC80\uBB38\uC758 \uC11C\uB85C \uB2E4\uB978 \uC0C1\uD0DC \u2014 \uBB3C\uB9AC\uC801\uC73C\uB85C \uB3D9\uC2DC \uC874\uC7AC \uBD88\uAC00."
  - AnomalyA: {fileID: 11400000, guid: 695f16f623c2cfe4c9c7818ae689d60b, type: 2}
    AnomalyB: {fileID: 11400000, guid: f81e27b6ece768146bc9c6c1f8f44303, type: 2}
    State: 0
    Note: "\uC124\uACC4 \uBB38\uC11C 7\uBC88 \uC608\uC2DC: \uAC19\uC740 \uADF8\uB9BC\uC5D0 \uAC78\uB824\uB3C4 \uC815\uBA74 \uC720\uC9C0 + \uB208\uB9DE\uCDA4 \uD68C\uD53C\uAC00 \uB3D9\uC2DC\uC5D0 \uAC00\uB2A5\uD574 \uAC80\uD1A0 \uC644\uB8CC. \uAE30\uBCF8\uAC12\uACFC \uB3D9\uC77C\uD558\uC9C0\uB9CC \uAC80\uD1A0 \uAE30\uB85D\uC6A9\uC73C\uB85C \uBA85\uC2DC\uC801\uC73C\uB85C \uB0A8\uAE40."
  - AnomalyA: {fileID: 11400000, guid: 028d873260401754eb6d180a4b4f7a9a, type: 2}
    AnomalyB: {fileID: 11400000, guid: f81e27b6ece768146bc9c6c1f8f44303, type: 2}
    State: 2
    Note: "\uD48D\uACBD\uD654\uB294 \uB4F1\uC744 \uB3CC\uB824\uC57C \uD558\uACE0(120\xB0+ 2\uCD08), \uBAA9\uC18C\uB9AC \uC804\uC2DC\uBB3C\uC5D0\uB294 \uB4F1\uC744 \uBCF4\uC774\uBA74 \uC548 \uB41C\uB2E4(90\xB0+ 2\uCD08). \uBAA9\uC18C\uB9AC\uAC00 \uAC19\uC740 \uC11C\uCABD \uBCBD\uC758 \uB2E4\uB978 \uADF8\uB9BC\uC5D0 \uAC78\uB9AC\uBA74 \uD48D\uACBD\uD654\uC5D0\uC11C \uB4F1\uC744 \uB3CC\uB9AC\uB294 \uC21C\uAC04 \uBAA9\uC18C\uB9AC \uCABD\uC5D0\uB3C4 \uB4F1\uC744 \uBCF4\uC774\uAC8C \uB418\uC5B4 \uB3D9\uC2DC\uC5D0 \uB9CC\uC871\uD560 \uC218 \uC5C6\uB2E4. \uC0C8\uBCBD 1\uC2DC\uC5D0 \uBAA9\uC18C\uB9AC\uAC00 \uCD94\uAC00\uB418\uBA74\uC11C \uCC98\uC74C \uAC19\uC774 \uBF51\uD790 \uC218 \uC788\uAC8C \uB41C \uC870\uD569."
